{
  "schema": 1,
  "profile": "new-installation",
  "paths": {
    "state": "/private/state",
    "registry": "/private/registry.json",
    "meeting_data": "/private/meeting",
    "upstream_dist": "/app/dist"
  },
  "couchdb": {
    "url": "http://127.0.0.1:15984",
    "user": "REPLACE_WITH_OWN_SYNC_USER",
    "password": "REPLACE_WITH_OWN_SYNC_PASSWORD",
    "database": "wiki",
    "passphrase": "REPLACE_WITH_OWN_E2E_PASSPHRASE",
    "obfuscate_paths": false,
    "case_sensitive": false
  },
  "http": {
    "bind": "127.0.0.1",
    "port": 18788,
    "public_origin": "https://wiki.example.invalid"
  },
  "agent": {
    "enabled": false,
    "mcp_url": "http://127.0.0.1:18788/mcp",
    "mcp_token": "REPLACE_WITH_OWN_CURATOR_TOKEN",
    "tool_timeout_ms": 60000,
    "max_segments_per_run": 3,
    "max_context_chars": 50000,
    "read_budget": {
      "context_window": 64000,
      "max_output": 8000,
      "fixed_tokens": 16000
    }
  },
  "model": {
    "mode": "disabled",
    "allow_model_calls": false,
    "base_url": "https://model.example.invalid/v1",
    "name": "CONFIGURE_YOUR_MODEL",
    "api_key": "REPLACE_WITH_OWN_MODEL_KEY",
    "max_requests_per_run": 4,
    "max_input_chars": 150000,
    "max_output_tokens": 8000,
    "max_response_bytes": 2097152,
    "timeout_ms": 120000
  }
}
